FROM node:22-slim

RUN apt-get update && apt-get install -y openssl && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package*.json ./
RUN npm install

COPY . .

RUN npx prisma generate
RUN npm run build

EXPOSE 8080

# El comando final: Arranca el servidor web y mantiene el contenedor vivo
CMD ["sh", "-c", "node server-baileys.cjs & wait"]